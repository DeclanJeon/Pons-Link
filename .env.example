# Browser-safe frontend configuration only.
# Runtime backend secrets live in ../Pons_Backend/.env, not in this Vite app.

VITE_SIGNALING_SERVER_URL=
VITE_GOOGLE_CLIENT_ID=

# Local backend default. For production switch to https://ponslink.online
VITE_API_URL=http://localhost:6650

# Optional override for lounge/personal-link API; keep aligned with VITE_API_URL unless splitting services.
VITE_PERSONAL_LINK_API_URL=http://localhost:6650

VITE_ENABLE_EMAIL_API=true

# Optional speech-token backend override; defaults can follow VITE_API_URL.
VITE_SPEECH_TOKEN_API_URL=http://localhost:6650
